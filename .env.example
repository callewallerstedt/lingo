# --- OpenAI (AI chat, tutor, speech) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- xAI Grok Voice (talking / Prata mode) ---
# Set in Vercel as XAI_API_KEY. Powers grok-voice-think-fast-2.0 realtime.
XAI_API_KEY=

# --- Database: Upstash Redis (Vercel Marketplace > Upstash for Redis) ---
# Vercel injects these automatically once the integration is connected.
# Leave blank for local-only mode: the app keeps everything in the browser
# and simply skips cloud sync.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared passphrase that gates cloud sync. Anything non-empty works.
# Leave blank to allow sync without a passphrase.
SYNC_SECRET=

# --- Push notifications (daily reminders) ---
# Generate a key pair with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/notify/run so only your scheduler can trigger it.
# Vercel Cron sends this automatically as a Bearer token.
CRON_SECRET=
